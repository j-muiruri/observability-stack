# Copy this file to .env, replace every REPLACE_WITH value, and protect .env
# (chmod 600 .env). Keep real values out of Git and chat logs.
# Use shell single quotes for values containing punctuation. Use hex secrets where
# practical (for example: openssl rand -hex 32).

# Grafana admin/bootstrap and SMTP credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD='REPLACE_WITH_UNIQUE_GRAFANA_ADMIN_PASSWORD'
GF_SMTP_ENABLED=true
GF_SMTP_HOST='smtp.example.com:587'
GF_SMTP_USER='REPLACE_WITH_GRAFANA_SMTP_USERNAME'
GF_SMTP_PASSWORD='REPLACE_WITH_GRAFANA_SMTP_PASSWORD'
GF_SMTP_FROM_ADDRESS='grafana-alerts@example.com'
GF_SMTP_FROM_NAME='Observability'
GRAFANA_RUN_UID=1000
GRAFANA_RUN_GID=1000

# Container resource limits and reservations. Tune these after measuring
# ingestion rate, active series/cardinality, query latency, and host capacity.
GRAFANA_CPU_LIMIT=0.25
GRAFANA_MEMORY_LIMIT=384M

PROMETHEUS_CPU_LIMIT=0.50
PROMETHEUS_MEMORY_LIMIT=1024M
PROMETHEUS_CPU_RESERVATION=0.10
PROMETHEUS_MEMORY_RESERVATION=256M

LOKI_CPU_LIMIT=0.30
LOKI_MEMORY_LIMIT=512M
LOKI_CPU_RESERVATION=0.10
LOKI_MEMORY_RESERVATION=128M

TEMPO_CPU_LIMIT=0.30
TEMPO_MEMORY_LIMIT=512M
TEMPO_CPU_RESERVATION=0.10
TEMPO_MEMORY_RESERVATION=128M

ALLOY_CPU_LIMIT=0.30
ALLOY_MEMORY_LIMIT=512M

# Host ports published by Docker Compose. Change the left-side host port here
# when the default is already used; the container-side port stays fixed.
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
TEMPO_PORT=3200
TEMPO_OTLP_GRPC_PORT=4317
TEMPO_OTLP_HTTP_PORT=4318
ALLOY_PORT=12345
ALLOY_OTLP_GRPC_PORT=4319
ALLOY_OTLP_HTTP_PORT=4320

# Prometheus scrape authentication. Rotate the token previously embedded in
# prometheus/prometheus.yml before using this deployment.
PROM_LARAVEL_BEARER_TOKEN='REPLACE_WITH_LARAVEL_METRICS_TOKEN'
PROM_NODEJS_BEARER_TOKEN='REPLACE_WITH_NODEJS_METRICS_TOKEN'
PROM_NESTJS_BEARER_TOKEN='REPLACE_WITH_NESTJS_METRICS_TOKEN'

# Alertmanager notification delivery
ALERT_SMTP_SMARTHOST='smtp.example.com:587'
ALERT_SMTP_FROM='alerts@example.com'
ALERT_SMTP_USERNAME='REPLACE_WITH_ALERT_SMTP_USERNAME'
ALERT_SMTP_PASSWORD='REPLACE_WITH_ALERT_SMTP_PASSWORD'
ALERT_EMAIL_TO='oncall@example.com'
ALERT_DISCORD_WEBHOOK_URL='https://discord.com/api/webhooks/REPLACE_WITH_ID/REPLACE_WITH_TOKEN/slack'
ALERT_SMS_WEBHOOK_URL='https://sms-gateway.example.com/v1/REPLACE_WITH_AUTHENTICATED_ENDPOINT'
