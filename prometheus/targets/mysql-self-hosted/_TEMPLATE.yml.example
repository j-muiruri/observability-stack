# Copy to <db-instance-name>.yml. Requires prometheus/mysqld_exporter with
# a read-only monitoring user (PROCESS, REPLICATION CLIENT, SELECT on
# performance_schema).
- targets:
    - "DB_HOST:9104"
  labels:
    job: "mysql-self-hosted"
    service: "SERVICE_NAME"
    team: "TEAM_NAME"
    env: "prod"
    tier: "1"
    stack: "mysql"
    hosting: "self-hosted"
