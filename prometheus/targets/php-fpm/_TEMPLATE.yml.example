# Copy to <service-name>.yml. Requires php-fpm status page enabled +
# a php-fpm exporter sidecar (e.g. hipages/php-fpm_exporter) pointed at it.
- targets:
    - "SERVICE_HOST:9253"
  labels:
    job: "php-fpm"
    service: "SERVICE_NAME"
    team: "TEAM_NAME"
    env: "prod"
    tier: "3"
    stack: "php-fpm"
