# Copy to <rds-instance-name>.yml. mysqld_exporter runs as its own small
# container/task pointed at the RDS endpoint.
- targets:
    - "EXPORTER_HOST:9104"
  labels:
    job: "rds-mysql"
    service: "SERVICE_NAME"
    team: "TEAM_NAME"
    env: "prod"
    tier: "1"
    stack: "mysql"
    hosting: "aws-rds"
