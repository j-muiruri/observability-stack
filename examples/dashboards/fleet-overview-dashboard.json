{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource provisioned in this stack (Connections \u2192 Data sources \u2192 Prometheus)",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.4.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "row", "name": "Row", "version": "" }
  ],
  "id": null,
  "uid": "fleet-overview-v1",
  "title": "Fleet Overview \u2014 All Services",
  "description": "Templated fleet-wide health dashboard for all instrumented services. Filter by team/service/environment. Complements per-service custom dashboards (link out from the 'Service Deep Link' row).",
  "tags": ["fleet", "sre", "red-metrics", "auto-generated"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "style": "dark",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",

  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "${DS_PROMETHEUS}" },
        "hide": 0,
        "label": "Data source",
        "refresh": 1
      },
      {
        "name": "env",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": { "query": "label_values(up, env)", "refId": "env-var" },
        "label": "Environment",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": { "text": ["All"], "value": ["$__all"] },
        "hide": 0
      },
      {
        "name": "team",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": { "query": "label_values(up{env=~\"$env\"}, team)", "refId": "team-var" },
        "label": "Team",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": { "text": ["All"], "value": ["$__all"] },
        "hide": 0
      },
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": { "query": "label_values(up{env=~\"$env\", team=~\"$team\"}, service)", "refId": "service-var" },
        "label": "Service",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": { "text": ["All"], "value": ["$__all"] },
        "hide": 0
      },
      {
        "name": "latency_slo_ms",
        "type": "textbox",
        "label": "Latency SLO (ms, p95)",
        "query": "500",
        "current": { "text": "500", "value": "500" },
        "hide": 0
      },
      {
        "name": "error_rate_slo_pct",
        "type": "textbox",
        "label": "Error rate SLO (%)",
        "query": "1",
        "current": { "text": "1", "value": "1" },
        "hide": 0
      }
    ]
  },

  "annotations": {
    "list": [
      {
        "name": "Alertmanager firing alerts",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\", service=~\"$service\", team=~\"$team\", env=~\"$env\"}",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{service}} \u2014 {{summary}}",
        "step": "30s"
      }
    ]
  },

  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Fleet Summary",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Services Up",
      "description": "Count of currently-up targets matching the selected filters.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "count(up{service=~\"$service\", team=~\"$team\", env=~\"$env\"} == 1)",
          "legendFormat": "Up",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Services Down",
      "description": "Count of currently-down targets matching the selected filters. Any non-zero value here should correlate with a firing ServiceDown alert.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "targets": [
        {
          "expr": "count(up{service=~\"$service\", team=~\"$team\", env=~\"$env\"} == 0) OR vector(0)",
          "legendFormat": "Down",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active Critical Alerts",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "targets": [
        {
          "expr": "count(ALERTS{alertstate=\"firing\", severity=\"critical\", service=~\"$service\", team=~\"$team\", env=~\"$env\"}) OR vector(0)",
          "legendFormat": "Critical",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "Fleet-Wide Error Rate (%)",
      "description": "Aggregate 5xx / total request ratio across all filtered services, against the error_rate_slo_pct threshold.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "100 * sum(rate(http_requests_total{service=~\"$service\", team=~\"$team\", env=~\"$env\", status=~\"5..\"}[5m])) / sum(rate(http_requests_total{service=~\"$service\", team=~\"$team\", env=~\"$env\"}[5m]))",
          "legendFormat": "Error %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 10,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 6,
      "type": "gauge",
      "title": "Fleet-Wide p95 Latency (ms)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "targets": [
        {
          "expr": "1000 * histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=~\"$service\", team=~\"$team\", env=~\"$env\"}[5m])) by (le))",
          "legendFormat": "p95 ms",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "max": 2000,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 300 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Total Request Rate (req/s)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=~\"$service\", team=~\"$team\", env=~\"$env\"}[5m]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },

    {
      "id": 10,
      "type": "row",
      "title": "Service Inventory (Table)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "panels": []
    },
    {
      "id": 11,
      "type": "table",
      "title": "All Services \u2014 Status, Error Rate, Latency, Owner",
      "description": "One row per service. Sort by any column to triage the whole fleet at a glance. Click a row's service name to deep-link (configure data links per your Grafana version if using table cell links).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "up{service=~\"$service\", team=~\"$team\", env=~\"$env\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "A"
        },
        {
          "expr": "100 * sum by (service) (rate(http_requests_total{service=~\"$service\", team=~\"$team\", env=~\"$env\", status=~\"5..\"}[5m])) / sum by (service) (rate(http_requests_total{service=~\"$service\", team=~\"$team\", env=~\"$env\"}[5m]))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "B"
        },
        {
          "expr": "1000 * histogram_quantile(0.95, sum by (service, le) (rate(http_request_duration_seconds_bucket{service=~\"$service\", team=~\"$team\", env=~\"$env\"}[5m])))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "C"
        },
        {
          "expr": "sum by (service) (rate(http_requests_total{service=~\"$service\", team=~\"$team\", env=~\"$env\"}[5m]))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "D"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {},
            "renameByName": {
              "service": "Service",
              "team": "Team",
              "env": "Env",
              "Value #A": "Up",
              "Value #B": "Error Rate (%)",
              "Value #C": "p95 Latency (ms)",
              "Value #D": "Req/s"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "filterable": true
          },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Up" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "green", "value": 1 }
                  ]
                }
              },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
                  { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Error Rate (%)" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 1 },
                    { "color": "red", "value": 5 }
                  ]
                }
              },
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 2 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p95 Latency (ms)" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 300 },
                    { "color": "red", "value": 500 }
                  ]
                }
              },
              { "id": "unit", "value": "ms" },
              { "id": "decimals", "value": 0 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Req/s" },
            "properties": [
              { "id": "unit", "value": "reqps" },
              { "id": "decimals", "value": 2 }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Error Rate (%)", "desc": true }]
      }
    },

    {
      "id": 20,
      "type": "row",
      "title": "RED Metrics (Rate / Errors / Duration)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Request Rate by Service (req/s)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_requests_total{service=~\"$service\", team=~\"$team\", env=~\"$env\"}[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "mode": "none" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Error Rate by Service (%)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "targets": [
        {
          "expr": "100 * sum by (service) (rate(http_requests_total{service=~\"$service\", team=~\"$team\", env=~\"$env\", status=~\"5..\"}[5m])) / sum by (service) (rate(http_requests_total{service=~\"$service\", team=~\"$team\", env=~\"$env\"}[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "p50 / p95 / p99 Latency \u2014 Aggregate",
      "description": "Aggregate latency percentiles across all filtered services. Use the table above or a custom dashboard for per-service latency breakdowns if this is too coarse.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "targets": [
        {
          "expr": "1000 * histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{service=~\"$service\", team=~\"$team\", env=~\"$env\"}[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "1000 * histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=~\"$service\", team=~\"$team\", env=~\"$env\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "1000 * histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{service=~\"$service\", team=~\"$team\", env=~\"$env\"}[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        },
        {
          "expr": "$latency_slo_ms",
          "legendFormat": "SLO threshold",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "SLO threshold" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Uptime (Up/Down) by Service",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "targets": [
        {
          "expr": "up{service=~\"$service\", team=~\"$team\", env=~\"$env\"}",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "none" }
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN" } } },
            { "type": "value", "options": { "1": { "text": "UP" } } }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },

    {
      "id": 30,
      "type": "row",
      "title": "Saturation (Resource Usage)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "panels": []
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "CPU Usage by Service (%)",
      "description": "Requires process/container CPU metrics exported (e.g. process_cpu_seconds_total or cadvisor container_cpu_usage_seconds_total). Adjust the metric name to match your exporter.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "targets": [
        {
          "expr": "100 * sum by (service) (rate(process_cpu_seconds_total{service=~\"$service\", team=~\"$team\", env=~\"$env\"}[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Memory (RSS) by Service",
      "description": "Requires process_resident_memory_bytes or the equivalent from your exporter.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 },
      "targets": [
        {
          "expr": "sum by (service) (process_resident_memory_bytes{service=~\"$service\", team=~\"$team\", env=~\"$env\"})",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },

    {
      "id": 40,
      "type": "row",
      "title": "Prometheus Self-Monitoring (Scale Health)",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 },
      "panels": [
        {
          "id": 41,
          "type": "timeseries",
          "title": "TSDB Head Series Count",
          "description": "Rising unbounded indicates cardinality growth \u2014 watch this as you add services. A sudden jump usually means a new high-cardinality label (user_id, request_id, etc.) leaked into a metric.",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 43 },
          "targets": [
            { "expr": "prometheus_tsdb_head_series", "legendFormat": "Head series", "refId": "A" }
          ],
          "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
          "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
        },
        {
          "id": 42,
          "type": "timeseries",
          "title": "Scrape Duration by Job",
          "description": "If scrape durations climb close to your scrape_interval, Prometheus is struggling to keep up \u2014 a signal you may need to shard or move to remote-write/Mimir.",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 43 },
          "targets": [
            { "expr": "scrape_duration_seconds", "legendFormat": "{{job}}", "refId": "A" }
          ],
          "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
          "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["max"] }, "tooltip": { "mode": "multi" } }
        },
        {
          "id": 43,
          "type": "stat",
          "title": "Prometheus Storage Used",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "gridPos": { "h": 4, "w": 6, "x": 0, "y": 51 },
          "targets": [
            { "expr": "prometheus_tsdb_storage_blocks_bytes", "legendFormat": "Storage bytes", "refId": "A" }
          ],
          "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
          "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
        },
        {
          "id": 44,
          "type": "stat",
          "title": "Failed Scrapes (last 5m)",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "gridPos": { "h": 4, "w": 6, "x": 6, "y": 51 },
          "targets": [
            { "expr": "sum(up == 0)", "legendFormat": "Failed", "refId": "A" }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
            },
            "overrides": []
          },
          "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" }
        }
      ]
    },

    {
      "id": 50,
      "type": "row",
      "title": "Service Deep Links (Custom Dashboards)",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 },
      "panels": [
        {
          "id": 51,
          "type": "text",
          "title": "How to link out to a custom dashboard",
          "gridPos": { "h": 6, "w": 24, "x": 0, "y": 44 },
          "options": {
            "mode": "markdown",
            "content": "For services with bespoke dashboards (queue depth, worker pools, DB connection pools, custom SLOs), add a **Dashboard link** in this dashboard's settings (Dashboard settings \u2192 Links \u2192 New link \u2192 Dashboard) targeting that service's dashboard, and pass `$service`, `$team`, `$env` as URL query params so the target dashboard opens pre-filtered.\n\nExample URL pattern:\n\n`/d/payments-api-custom/payments-api?var-service=${service}&var-env=${env}`\n\nTag every custom dashboard with `custom` (and the shared ones with `fleet`) so both are filterable from the main Grafana dashboard list as the fleet grows past 50 services."
          }
        }
      ]
    }
  ]
}
