{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "description": "Same datasource as Fleet Overview", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus" }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.4.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "id": null,
  "uid": "java-spring-boot-v1",
  "title": "Java / Spring Boot \u2014 JVM & Actuator",
  "description": "Templated across all Spring Boot services (job=spring-boot). RED metrics from Actuator/Micrometer, JVM heap/GC, thread pools, and DB connection pool saturation (HikariCP).",
  "tags": ["custom", "java", "spring-boot", "jvm"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "style": "dark",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "links": [
    { "title": "\u2190 Fleet Overview", "type": "link", "url": "/d/fleet-overview-v1/fleet-overview-all-services?var-service=${service}&var-env=${env}", "targetBlank": false }
  ],

  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus", "current": { "text": "Prometheus", "value": "${DS_PROMETHEUS}" }, "hide": 0, "label": "Data source", "refresh": 1 },
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": { "query": "label_values(up{job=\"spring-boot\"}, service)", "refId": "svc" },
        "label": "Service",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": { "text": ["All"], "value": ["$__all"] },
        "hide": 0
      },
      {
        "name": "env",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": { "query": "label_values(up{job=\"spring-boot\", service=~\"$service\"}, env)", "refId": "env" },
        "label": "Environment",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": { "text": ["All"], "value": ["$__all"] },
        "hide": 0
      }
    ]
  },

  "annotations": {
    "list": [
      {
        "name": "Firing alerts",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\", service=~\"$service\", env=~\"$env\"}",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{summary}}",
        "step": "30s"
      }
    ]
  },

  "panels": [
    {
      "id": 1, "type": "row", "title": "RED Metrics", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": []
    },
    {
      "id": 2, "type": "timeseries", "title": "Request Rate by Endpoint",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "targets": [
        { "expr": "sum by (service, uri) (rate(http_server_requests_seconds_count{service=~\"$service\", env=~\"$env\"}[5m]))", "legendFormat": "{{service}} {{uri}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 3, "type": "timeseries", "title": "Error Rate (%) \u2014 5xx",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "targets": [
        { "expr": "100 * sum by (service) (rate(http_server_requests_seconds_count{service=~\"$service\", env=~\"$env\", status=~\"5..\"}[5m])) / sum by (service) (rate(http_server_requests_seconds_count{service=~\"$service\", env=~\"$env\"}[5m]))", "legendFormat": "{{service}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 4, "type": "timeseries", "title": "Latency p50 / p95 / p99 (ms)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 9 },
      "targets": [
        { "expr": "1000 * histogram_quantile(0.50, sum by (le, service) (rate(http_server_requests_seconds_bucket{service=~\"$service\", env=~\"$env\"}[5m])))", "legendFormat": "{{service}} p50", "refId": "A" },
        { "expr": "1000 * histogram_quantile(0.95, sum by (le, service) (rate(http_server_requests_seconds_bucket{service=~\"$service\", env=~\"$env\"}[5m])))", "legendFormat": "{{service}} p95", "refId": "B" },
        { "expr": "1000 * histogram_quantile(0.99, sum by (le, service) (rate(http_server_requests_seconds_bucket{service=~\"$service\", env=~\"$env\"}[5m])))", "legendFormat": "{{service}} p99", "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },

    {
      "id": 10, "type": "row", "title": "JVM Health", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }, "panels": []
    },
    {
      "id": 11, "type": "timeseries", "title": "Heap Memory Used vs Max",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "targets": [
        { "expr": "sum by (service) (jvm_memory_used_bytes{service=~\"$service\", env=~\"$env\", area=\"heap\"})", "legendFormat": "{{service}} used", "refId": "A" },
        { "expr": "sum by (service) (jvm_memory_max_bytes{service=~\"$service\", env=~\"$env\", area=\"heap\"})", "legendFormat": "{{service}} max", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*max" }, "properties": [{ "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 12, "type": "timeseries", "title": "GC Pause Time (rate, seconds)",
      "description": "Sustained high values indicate memory pressure \u2014 correlates with heap-near-max on the left. Frequent long pauses show up as latency spikes in the RED metrics above.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "targets": [
        { "expr": "sum by (service, action) (rate(jvm_gc_pause_seconds_sum{service=~\"$service\", env=~\"$env\"}[5m]))", "legendFormat": "{{service}} {{action}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 13, "type": "timeseries", "title": "CPU Usage (Process)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "targets": [
        { "expr": "100 * sum by (service) (process_cpu_usage{service=~\"$service\", env=~\"$env\"})", "legendFormat": "{{service}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 14, "type": "timeseries", "title": "Live Thread Count",
      "description": "Steadily climbing thread count with no plateau often means a thread leak (e.g. unbounded thread pool, unclosed executor).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "targets": [
        { "expr": "sum by (service) (jvm_threads_live_threads{service=~\"$service\", env=~\"$env\"})", "legendFormat": "{{service}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },

    {
      "id": 20, "type": "row", "title": "Database Connection Pool (HikariCP)", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }, "panels": []
    },
    {
      "id": 21, "type": "timeseries", "title": "Active vs Max Pool Connections",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "targets": [
        { "expr": "sum by (service) (hikaricp_connections_active{service=~\"$service\", env=~\"$env\"})", "legendFormat": "{{service}} active", "refId": "A" },
        { "expr": "sum by (service) (hikaricp_connections_max{service=~\"$service\", env=~\"$env\"})", "legendFormat": "{{service}} max", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*max" }, "properties": [{ "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 22, "type": "timeseries", "title": "Connection Pending / Timeout Rate",
      "description": "Threads waiting for a connection means the pool is undersized for current load \u2014 usually shows up as latency spikes upstream before this panel confirms the cause.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "targets": [
        { "expr": "sum by (service) (hikaricp_connections_pending{service=~\"$service\", env=~\"$env\"})", "legendFormat": "{{service}} pending", "refId": "A" },
        { "expr": "sum by (service) (rate(hikaricp_connections_timeout_total{service=~\"$service\", env=~\"$env\"}[5m]))", "legendFormat": "{{service}} timeout/s", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    }
  ]
}
